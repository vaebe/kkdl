    "commitizen": "^4.3.1",
    "commitlint": "^20.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "lint-staged": "^16.2.7",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.97.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
